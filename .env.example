# ============================
# K-TEX BACKEND CONFIGURATION
# ============================

# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/ktex_db
# Production: mongodb+srv://username:password@cluster.mongodb.net/ktex_db

# JWT
JWT_SECRET=ktex_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Admin bootstrap (used by npm run create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=KHM Admin
ADMIN_PHONE=+923001234567

# Email (Brevo / Sendinblue)
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=orders@ktexstore.com
BREVO_SENDER_NAME=K-TEX Store

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloudinary (required for image uploads across the app)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK (required for Google admin login)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...your-key...\n-----END PRIVATE KEY-----\n"
